/* 🏗️ CONTENEDOR PRINCIPAL DEL LOGIN
   Este es el wrapper principal que centra todo el contenido */
.login-container {
  min-height: 100vh; /* 📏 Altura mínima de toda la pantalla */
  display: flex; /* 🎯 Flexbox para centrar contenido */
  align-items: center; /* ⬆️ Centrar verticalmente */
  justify-content: center; /* ➡️ Centrar horizontalmente */
  padding: var(--spacing-lg); /* 🎨 Espaciado interno */
  position: relative; /* 📐 Para posicionar elementos hijos */
  overflow: hidden; /* 🚫 Evitar scroll horizontal */

  /* 📱 RESPONSIVE: Se adapta automáticamente gracias a flexbox */
  box-sizing: border-box; /* 📦 Incluir padding en el ancho total */
}

.login-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
      circle at 20% 50%,
      rgba(222, 89, 31, 0.15) 0%,
      transparent 50%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(222, 89, 31, 0.1) 0%,
      transparent 50%
    );
  z-index: 0;
}

/* 🎴 TARJETA PRINCIPAL DEL LOGIN
   Contiene todo el formulario y se adapta responsivamente */
.login-card {
  background-color: var(--c-surface); /* 🎨 Color de fondo dinámico */
  border: 1px solid var(--c-border); /* 🖼️ Borde sutil */
  border-radius: var(--radius-xl); /* 🔘 Esquinas redondeadas */
  padding: var(--spacing-2xl); /* 🎯 Espaciado interno generoso */
  width: 100%; /* 📐 Se adapta al contenedor padre */
  max-width: 450px; /* 🎯 Ancho máximo para pantallas grandes */
  box-shadow: var(--shadow-xl); /* ✨ Sombra elegante */
  position: relative; /* 📐 Para elementos posicionados */
  z-index: 1; /* 📚 Aparecer sobre el fondo */
  animation: fadeIn 0.5s ease-out; /* 🎬 Animación suave de entrada */

  /* 📱 RESPONSIVE: En móviles se adapta automáticamente */
  box-sizing: border-box; /* 📦 Cálculo correcto de dimensiones */
  transition: all 0.3s ease; /* 🎭 Transiciones suaves */
}

.login-header {
  text-align: center;
  margin-bottom: var(--spacing-xl);
}

.login-logo {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.login-logo-icon {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, var(--c-brand), #ff6a2f);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  box-shadow: var(--shadow-lg);
}

.login-header h1 {
  font-family: var(--font-bold);
  font-size: 2rem;
  color: var(--c-text-cream);
  margin-bottom: var(--spacing-xs);
}

.login-header p {
  color: var(--c-text);
  opacity: 0.8;
  font-size: 1rem;
  margin: 0;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
}

.login-footer {
  text-align: center;
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--c-border);
}

.login-demo-info {
  background-color: rgba(222, 89, 31, 0.1);
  border: 1px solid var(--c-brand);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  font-size: 0.875rem;
  color: var(--c-text-cream);
}

.login-demo-info strong {
  font-family: var(--font-bold);
  color: var(--c-brand);
}

.demo-info-banner {
  background: linear-gradient(
    135deg,
    rgba(79, 70, 229, 0.1),
    rgba(147, 51, 234, 0.1)
  );
  border: 1px solid rgba(147, 51, 234, 0.3);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  display: flex;
  gap: var(--spacing-sm);
  align-items: flex-start;
}

.demo-info-banner svg {
  flex-shrink: 0;
  color: #9333ea;
  margin-top: 2px;
}

.demo-info-banner strong {
  display: block;
  color: var(--c-text-cream);
  font-family: var(--font-bold);
  margin-bottom: var(--spacing-xs);
}

.demo-info-banner p {
  margin: 0;
  font-size: 0.875rem;
  color: var(--c-text);
  line-height: 1.5;
}

.demo-credentials {
  background-color: rgba(222, 89, 31, 0.05);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  text-align: left;
}

.demo-credentials p {
  margin: var(--spacing-xs) 0;
  font-size: 0.875rem;
  color: var(--c-text);
}

.demo-credentials code {
  background-color: rgba(0, 0, 0, 0.2);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-family: "Courier New", monospace;
  color: var(--c-brand);
  font-weight: 600;
}

.demo-credentials strong {
  color: var(--c-text-cream);
  font-family: var(--font-bold);
}

.login-copyright {
  font-size: 0.875rem;
  color: var(--c-text);
  opacity: 0.6;
  margin: 0;
}

/* Password toggle styles */
.password-input-container {
  position: relative;
}

.password-toggle {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--c-text);
  opacity: 0.6;
  cursor: pointer;
  padding: 6px;
  border-radius: var(--radius-sm);
  transition: var(--transition-fast);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
}

.password-toggle:hover {
  opacity: 1;
  background-color: var(--c-surface-light);
}

.password-toggle:focus {
  outline: 2px solid var(--c-brand);
  opacity: 1;
}

/* Ajustar el padding del input para hacer espacio al ícono */
.password-input-container .input-wrapper input {
  padding-right: 48px !important;
}

/* Botones NORMALES (por defecto) */
.login-form .btn {
  padding: 8px var(--spacing-lg);
  font-size: 0.875rem;
  font-weight: 600;
  height: auto;
  min-height: 38px;
  max-height: 38px;
}

/* 🟢 BOTONES GRANDES SOLO PARA VERSIÓN DEMO
   Estos estilos solo se aplican cuando .demo-login está presente
   Hace los botones grandes y visualmente atractivos para demos */
.demo-login .login-form .btn {
  width: 220px; /* 📏 Ancho fijo para consistencia */
  height: 175px; /* 📏 Alto generoso para visibilidad */
  min-height: 175px; /* 🎯 Altura mínima garantizada */
  max-height: 175px; /* 🎯 Altura máxima controlada */
  padding: var(--spacing-md); /* 🎨 Espaciado interno */
  font-size: 1rem; /* 🔤 Texto legible */
  font-weight: 600; /* 💪 Texto en negrita */
  display: flex; /* 🎯 Flexbox para centrar contenido */
  flex-direction: column; /* ⬇️ Apilar elementos verticalmente */
  align-items: center; /* ➡️ Centrar horizontalmente */
  justify-content: center; /* ⬆️ Centrar verticalmente */
  text-align: center; /* 📝 Texto centrado */
  line-height: 1.4; /* 📏 Espaciado entre líneas */
  margin: 0 auto var(--spacing-md); /* 🎯 Centrar y espaciar */
  flex: none; /* 🚫 No crecer ni encogerse */

  /* 🎭 EFECTOS VISUALES */
  transition: all 0.3s ease; /* ⚡ Animaciones suaves */
  cursor: pointer; /* 👆 Indicar que es clickeable */
}

.demo-login .login-form .btn[type="submit"] {
  margin-bottom: var(--spacing-lg);
}

/* Contenedor de botones demo */
.demo-buttons {
  display: flex;
  gap: var(--spacing-md);
  width: 100%;
  justify-content: center;
}

/* Botones demo NORMALES por defecto */
.demo-buttons .btn {
  flex: 0 0 auto;
  height: 28px;
  min-height: 28px;
  max-height: 28px;
  width: auto;
  padding: 0 var(--spacing-md);
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.4;
}

/* 🎯 LAYOUT DE BOTONES EN VERSIÓN DEMO - DISEÑO HORIZONTAL
   Organiza los botones uno al lado del otro para mejor UX en demo */
.demo-login .login-form {
  display: flex; /* 🎯 Flexbox para organización */
  flex-direction: column; /* ⬇️ Elementos apilados verticalmente */
  gap: var(--spacing-lg); /* 📏 Espaciado entre elementos */
  margin-bottom: var(--spacing-xl); /* 🎨 Margen inferior */
}

/* 🎮 CONTENEDOR DE BOTONES DEMO
   Organiza los botones de acción de la demo horizontalmente */
.demo-login .demo-buttons-container {
  display: flex; /* 🎯 Flexbox para alineación horizontal */
  gap: var(--spacing-lg); /* 📏 Separación entre botones */
  width: 100%; /* 📐 Ocupa todo el ancho disponible */
  justify-content: center; /* ➡️ Centrar botones horizontalmente */
  align-items: flex-start; /* ⬆️ Alinear al inicio verticalmente */

  /* 📱 RESPONSIVE: En móviles se convierte en columna (ver media queries) */
  flex-wrap: wrap; /* 🔄 Permitir salto de línea si es necesario */
}

/* Botones demo GRANDES solo en versión demo */
.demo-login .demo-buttons .btn,
.demo-login .login-form .btn {
  height: 120px;
  min-height: 120px;
  max-height: 120px;
  width: 200px;
  padding: var(--spacing-md);
  font-size: 1rem;
  flex-direction: column;
  flex: 0 0 auto;
}

/* 🌙 TEMA OSCURO - BOTÓN SECUNDARIO DEMO
   Estilo especial para el botón de credenciales automáticas en tema oscuro */
.demo-buttons .btn-secondary,
.demo-login .demo-buttons .btn-secondary {
  background: linear-gradient(
    135deg,
    #4c1d95,
    #5b21b6
  ); /* 🟣 Gradiente morado */
  border: 2px solid #7c3aed; /* 🖼️ Borde morado brillante */
  color: #ffffff; /* 🔤 Texto blanco para contraste */
  box-shadow: 0 4px 8px rgba(124, 58, 237, 0.3); /* ✨ Sombra morada */

  /* 🎭 EFECTOS DE INTERACCIÓN */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); /* ⚡ Transición suave */
}

/* 👆 HOVER - BOTÓN SECUNDARIO TEMA OSCURO
   Efectos visuales cuando el usuario pasa el mouse por encima */
.demo-buttons .btn-secondary:hover:not(:disabled),
.demo-login .demo-buttons .btn-secondary:hover:not(:disabled) {
  background: linear-gradient(
    135deg,
    #5b21b6,
    #6d28d9
  ); /* 🟣 Gradiente más brillante */
  border-color: #8b5cf6; /* 🖼️ Borde más claro */
  transform: translateY(-2px); /* ⬆️ Efecto de elevación */
  box-shadow: 0 8px 16px rgba(124, 58, 237, 0.4); /* ✨ Sombra más intensa */

  /* 🎯 FEEDBACK VISUAL para mejorar UX */
  cursor: pointer; /* 👆 Confirmar que es clickeable */
}

/* ☀️ TEMA CLARO - BOTÓN SECUNDARIO DEMO
   Adaptación del botón para el tema claro con colores azules */
[data-theme="light"] .demo-buttons .btn-secondary,
[data-theme="light"] .demo-login .demo-buttons .btn-secondary {
  background: linear-gradient(135deg, #1e40af, #2563eb); /* 🔵 Gradiente azul */
  border: 2px solid #3b82f6; /* 🖼️ Borde azul brillante */
  color: #ffffff; /* 🔤 Texto blanco para contraste */
  box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3); /* ✨ Sombra azul */

  /* 🎨 CONSISTENCIA: Mismos efectos que tema oscuro pero colores diferentes */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); /* ⚡ Transición idéntica */
}

/* 👆 HOVER - TEMA CLARO BOTÓN SECUNDARIO
   Efectos de hover consistentes con el tema claro */
[data-theme="light"] .demo-buttons .btn-secondary:hover:not(:disabled),
[data-theme="light"]
  .demo-login
  .demo-buttons
  .btn-secondary:hover:not(:disabled) {
  background: linear-gradient(
    135deg,
    #2563eb,
    #3b82f6
  ); /* 🔵 Azul más brillante */
  border-color: #60a5fa; /* 🖼️ Borde azul claro */
  transform: translateY(-2px); /* ⬆️ Misma elevación que tema oscuro */
  box-shadow: 0 8px 16px rgba(59, 130, 246, 0.4); /* ✨ Sombra azul intensa */

  /* 🎯 COHERENCIA: Mismo comportamiento en ambos temas */
  cursor: pointer; /* 👆 Indicador de interacción */
}

/* ========================================
   📱 RESPONSIVE DESIGN - MEDIA QUERIES
   ======================================== */

/* 📋 GUÍA RESPONSIVE: Las media queries permiten adaptar el diseño
   a diferentes tamaños de pantalla. Se aplican de mayor a menor */

/* 💻 TABLETS Y PANTALLAS MEDIANAS (768px - 1024px) */
@media (max-width: 1024px) and (min-width: 769px) {
  /* 🎯 Demo: Botones medianos para tablets */
  .demo-login .demo-buttons .btn,
  .demo-login .login-form .btn {
    height: 140px;
    width: 180px;
    font-size: 0.95rem;
  }

  .login-card {
    max-width: 500px;
  }
}

/* 📱 MOBILE Y TABLETS PEQUEÑAS (hasta 768px) */
@media (max-width: 768px) {
  /* 🏗️ ESTRUCTURA BASE: Ajustes generales para mobile */
  .login-container {
    padding: var(--spacing-sm); /* ⚡ Menos padding en móvil */
    min-height: 100vh;
  }

  .login-card {
    padding: var(--spacing-lg);
    max-width: 100%; /* 📐 Ocupa todo el ancho disponible */
    margin: 0 var(--spacing-sm);
  }

  /* 🎨 HEADER: Logo y títulos más pequeños */
  .login-header h1 {
    font-size: 1.5rem; /* 📏 Título más pequeño */
  }

  .login-logo-icon {
    width: 56px;
    height: 56px;
    font-size: 2.2rem;
  }

  /* 🟢 DEMO: Botones apilados verticalmente en móvil */
  .demo-login .demo-buttons-container {
    flex-direction: column; /* 📱 Cambiar a columna */
    gap: var(--spacing-md);
    align-items: center;
  }

  .demo-login .demo-buttons .btn,
  .demo-login .login-form .btn {
    height: 100px; /* 📏 Más pequeños en móvil */
    width: 100%;
    max-width: 280px; /* 🎯 Ancho máximo controlado */
    font-size: 0.9rem;
  }

  /* 🔒 CONTROLES: Ajustar botón de mostrar contraseña */
  .password-toggle {
    right: 12px;
    width: 28px;
    height: 28px;
    padding: 4px;
  }

  .password-input-container .input-wrapper input {
    padding-right: 44px !important;
  }
}

/* 📱 MÓVILES PEQUEÑOS (hasta 480px) */
@media (max-width: 480px) {
  /* 🎯 DEMO: Ajustes para pantallas muy pequeñas */
  .login-container {
    padding: var(--spacing-xs);
  }

  .login-card {
    padding: var(--spacing-md);
    margin: 0;
  }

  .login-header h1 {
    font-size: 1.25rem;
  }

  .login-header p {
    font-size: 0.8rem;
  }

  /* 🟢 DEMO: Botones más compactos */
  .demo-login .demo-buttons .btn,
  .demo-login .login-form .btn {
    height: 80px;
    font-size: 0.85rem;
    padding: var(--spacing-sm);
  }

  /* 🏷️ BANNER: Más compacto */
  .demo-info-banner {
    padding: var(--spacing-sm);
    font-size: 0.8rem;
  }

  /* 🔤 FORMULARIO: Inputs más compactos */
  .input-wrapper {
    margin-bottom: var(--spacing-sm);
  }
}

/* 🖥️ PANTALLAS GRANDES (más de 1200px) */
@media (min-width: 1200px) {
  /* 🎯 Demo: Botones más grandes en pantallas amplias */
  .demo-login .demo-buttons .btn,
  .demo-login .login-form .btn {
    height: 160px;
    width: 240px;
    font-size: 1.1rem;
  }

  .login-card {
    max-width: 520px;
  }
}
