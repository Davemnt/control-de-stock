rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNCIONES DE SEGURIDAD SIMPLIFICADAS
    // ============================================
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ============================================
    // COLECCIÓN: USERS
    // ============================================
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIÓN: DEMO_USERS (Usuarios demo separados)
    // ============================================
    match /demo_users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIONES DEMO (Datos separados para demostración)
    // ============================================
    match /demo_materials/{materialId} {
      allow read, write: if isAuthenticated();
    }
    
    match /demo_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }
    
    match /demo_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIÓN: MATERIALS
    // ============================================
    match /materials/{materialId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIÓN: MOVEMENTS
    // ============================================
    match /movements/{movementId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIÓN: LOGS
    // ============================================
    match /logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // COLECCIÓN: SYSTEM_CONFIG
    // ============================================
    match /system/{configId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // DENEGAR TODO LO DEMÁS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
